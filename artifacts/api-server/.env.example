# Handyskillz API server
NODE_ENV=production
# Optional locally (defaults to 3000). Render provides PORT automatically.
PORT=3000
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
CLERK_PROXY_HOST=
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_PROFILE_BUCKET=profile-media
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
PAYSTACK_CALLBACK_URL=https://api.example.com/payments/callback
CORS_ORIGIN=https://your-web-domain.example
ADMIN_USER_IDS=user_id_1,user_id_2
